{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_overview": {
            "type": "panel",
            "label": "Overview",
            "items": {
                "_view": {
                    "type": "custom",
                    "webComponent": "webcomponents/weather-insights.json",
                    "settings": {
                        "instance": "weather-insights.${_instance}"
                    },
                    "height": 460,
                    "help": "The same view is available as a widget in vis-2, devices and Aura.",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                }
            }
        },
        "_sensors": {
            "type": "panel",
            "label": "Sensors",
            "items": {
                "_info": {
                    "type": "staticText",
                    "text": "Every field is optional. If a sensor is not set, the value of the Open-Meteo forecast is used.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_hOutdoor": {
                    "type": "header",
                    "text": "Outdoor sensors",
                    "size": 4,
                    "newLine": true
                },
                "pressureId": {
                    "type": "objectId",
                    "label": "Air pressure",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "pressureType": {
                    "type": "select",
                    "label": "Pressure type",
                    "help": "Absolute sensors (e.g. BME280) measure the station pressure. It is reduced to sea level with the altitude.",
                    "options": [
                        {
                            "label": "Detect automatically",
                            "value": "auto"
                        },
                        {
                            "label": "Station pressure (absolute)",
                            "value": "station"
                        },
                        {
                            "label": "Sea-level pressure (relative)",
                            "value": "sealevel"
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "temperatureId": {
                    "type": "objectId",
                    "label": "Outdoor temperature",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "humidityId": {
                    "type": "objectId",
                    "label": "Outdoor humidity",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "windSpeedId": {
                    "type": "objectId",
                    "label": "Wind speed",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "windUnit": {
                    "type": "select",
                    "label": "Wind unit",
                    "options": [
                        {
                            "label": "From the unit of the state",
                            "value": "auto"
                        },
                        {
                            "label": "m/s",
                            "value": "ms"
                        },
                        {
                            "label": "km/h",
                            "value": "kmh"
                        },
                        {
                            "label": "mph",
                            "value": "mph"
                        },
                        {
                            "label": "knots",
                            "value": "kn"
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "windGustId": {
                    "type": "objectId",
                    "label": "Wind gust",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "windDirectionId": {
                    "type": "objectId",
                    "label": "Wind direction",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "_hIndoor": {
                    "type": "header",
                    "text": "Indoor sensors (ventilation and mould)",
                    "size": 4,
                    "newLine": true
                },
                "indoorTemperatureId": {
                    "type": "objectId",
                    "label": "Indoor temperature",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "indoorHumidityId": {
                    "type": "objectId",
                    "label": "Indoor humidity",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "useHistory": {
                    "type": "checkbox",
                    "label": "Load the last 24 hours from the default history instance",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_location": {
            "type": "panel",
            "label": "Location and forecast",
            "items": {
                "useSystemLocation": {
                    "type": "checkbox",
                    "label": "Use the location of the system settings",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "latitude": {
                    "type": "number",
                    "label": "Latitude",
                    "min": -90,
                    "max": 90,
                    "hidden": "data.useSystemLocation",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "longitude": {
                    "type": "number",
                    "label": "Longitude",
                    "min": -180,
                    "max": 180,
                    "hidden": "data.useSystemLocation",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "altitude": {
                    "type": "number",
                    "label": "Altitude of the pressure sensor (m)",
                    "help": "Empty: the elevation of the forecast grid cell is used",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "forecastEnabled": {
                    "type": "checkbox",
                    "label": "Load the forecast from Open-Meteo",
                    "help": "Free, no API key. Needed for the outlook for tomorrow, CAPE and frost at night.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "forecastInterval": {
                    "type": "number",
                    "label": "Forecast interval (minutes)",
                    "min": 15,
                    "max": 360,
                    "hidden": "!data.forecastEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "_health": {
            "type": "panel",
            "label": "Weather sensitivity",
            "items": {
                "healthEnabled": {
                    "type": "checkbox",
                    "label": "Calculate the weather sensitivity",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "sensitivity": {
                    "type": "select",
                    "label": "Sensitivity",
                    "hidden": "!data.healthEnabled",
                    "options": [
                        {
                            "label": "Low",
                            "value": "low"
                        },
                        {
                            "label": "Normal",
                            "value": "normal"
                        },
                        {
                            "label": "High",
                            "value": "high"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "healthDirection": {
                    "type": "select",
                    "label": "Pressure changes that matter",
                    "hidden": "!data.healthEnabled",
                    "options": [
                        {
                            "label": "Rising and falling",
                            "value": "both"
                        },
                        {
                            "label": "Only falling",
                            "value": "falling"
                        },
                        {
                            "label": "Only rising",
                            "value": "rising"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "_healthInfo": {
                    "type": "staticText",
                    "text": "The levels are technical starting values, not medical limits. Record migraine days with the buttons health.migraineToday and health.migraineYesterday; after 14 days the adapter suggests a sensitivity.",
                    "hidden": "!data.healthEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
