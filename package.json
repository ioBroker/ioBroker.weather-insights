{
  "name": "iobroker.weather-insights",
  "version": "0.0.0",
  "description": "Derives conclusions from weather sensors and forecasts: pressure tendency, storm risk, Zambretti forecast, fog, frost, fronts, ventilation and weather sensitivity (migraine)",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "homepage": "https://github.com/ioBroker/ioBroker.weather-insights",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "weather",
    "barometer",
    "pressure",
    "tendency",
    "storm",
    "zambretti",
    "dew point",
    "migraine",
    "open-meteo"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.weather-insights"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/legacy-testing": "^4.0.1",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^7.2.2",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha --exit",
    "test:unit": "mocha test/insights.test.js --exit",
    "lint": "eslint -c eslint.config.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:webcomponents": "npm --prefix src-webcomponents ci && npm --prefix src-webcomponents run build",
    "check": "tsc --noEmit",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-webcomponents && npx -y npm-check-updates --upgrade",
    "release": "release-script",
    "test:package": "mocha test/package.test.js --exit",
    "test:integration": "mocha test/testAdapter.test.js --exit",
    "release-patch": "release-script patch --yes --no-update-lockfile",
    "release-minor": "release-script minor --yes --no-update-lockfile",
    "release-major": "release-script major --yes --no-update-lockfile",
    "npm": "npm i && cd src-webcomponents && npm i"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.weather-insights/issues"
  },
  "readmeFilename": "README.md"
}
